{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "UploadFolder": "wwwroot/uploads", // 存储路径（建议放在wwwroot下）
    "MaxFileSizeMB": 5, // 最大文件大小(MB)
    "AllowedImageTypes": [ // 允许的图片类型
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/bmp",
      "image/webp"
    ]
  },
  "ConnectionStrings": {
    "MySqlConnection": "Server=192.168.2.18;Database=TestDB;User=PyDataStudio;Password=admin1234;Port=3306;SslMode=None;"
  },
  "Jwt": {
    "SecretKey": "your_jwt_secret_key_here_should_be_long_and_random",
    "Issuer": "your_issuer",
    "Audience": "your_audience",
    "ExpiresInMinutes": 1440 // 24小时过期
  }
}